      "interactions": ["expand", "collapse", "focus", "blur", "keyboard-arrow"],
      "do": [
        "Wrap Accordion in Card for surface chrome",
        "Use foreground-only hover (title + caret shift to indigo)",
        "Suppress border on last item"
      ],
      "dont": [
        "Add background tint on hover",
